              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es el usuario creado\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"userId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "UpdateUser",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{userId}},\n  \"nombres\": \"Prueba Editada\",\n  \"apellidos\": \"Postman\",\n  \"fechanacimiento\": \"1996-05-10\",\n  \"telefono\": \"{{telefonoNuevo}}\",\n  \"email\": \"postman{{telefonoNuevo}}@abank.test\",\n  \"direccion\": \"Santa Tecla\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test(\"Guardó los cambios\", () => pm.expect(user.nombres).to.eql(\"Prueba Editada\"));",
                  "pm.test(\"El trigger marcó la modificación\", () => pm.expect(user.fechamodificacion).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
