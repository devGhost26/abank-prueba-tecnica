            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Prueba\",\n  \"apellidos\": \"Postman\",\n  \"fechanacimiento\": \"1996-05-10\",\n  \"telefono\": \"{{telefonoNuevo}}\",\n  \"email\": \"postman{{telefonoNuevo}}@abank.test\",\n  \"password\": \"Clave2026\",\n  \"direccion\": \"San Salvador\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"ProblemDetails con errorCode User.PhoneAlreadyExists\", () => pm.expect(pm.response.json().errorCode).to.eql(\"User.PhoneAlreadyExists\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "CreateUser con datos inválidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"test\",\n  \"apellidos\": \"\",\n  \"fechanacimiento\": \"2020-01-01\",\n  \"telefono\": \"12\",\n  \"email\": \"x\",\n  \"password\": \"123\",\n  \"direccion\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Marca cada campo\", () => pm.expect(Object.keys(pm.response.json().errors)).to.include.members([\"apellidos\",\"fechanacimiento\",\"telefono\",\"email\",\"password\",\"direccion\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "GetUser",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
